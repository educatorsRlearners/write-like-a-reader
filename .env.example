# Copy this file to .env and fill in the key for the provider you use.
# .env is gitignored and is ONLY for secrets — API keys that must not be
# committed. config.py loads it at startup (load_dotenv()) and each vendor
# SDK reads its own key straight from the environment.
#
# Everything else — which provider, the model, timeouts, ports — is set in
# config.py, not here. Not needed at all for the default local Ollama setup.

# Set ONLY the one matching LLM_PROVIDER in config.py:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Grok / xAI — GROK_API_KEY is preferred; XAI_API_KEY (xAI's own name) also works.
GROK_API_KEY=
