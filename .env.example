# Copy this file to .env and fill in the values you need. .env is gitignored.
# config.py calls load_dotenv() at startup, so these are picked up automatically.
# Every var here has a sensible default — you only need the ones you want to change.

# --- LLM provider ----------------------------------------------------------
# One of: ollama (default, fully local, no key needed), openai, anthropic, deepseek.
LLM_PROVIDER=ollama

# Model name for the chosen provider.
# For ollama this falls back to OLLAMA_MODEL (default qwen2.5:3b) if left blank.
LLM_MODEL=

# Provider API key — set ONLY the one matching LLM_PROVIDER above.
# The vendor SDKs read these exact variable names. Not needed for ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional: override the provider's base URL (Azure OpenAI, Groq, a proxy, a
# self-hosted gateway, ...). For ollama this falls back to OLLAMA_HOST.
LLM_BASE_URL=

# Optional LLM tuning (defaults shown).
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=4096
# LLM_NUM_CTX=8192           # ollama only

# --- Ollama (only used when LLM_PROVIDER=ollama) --------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=60

# --- App / storage -------------------------------------------------------
# DB_PATH=data/essays.db
# APP_HOST=127.0.0.1
# APP_PORT=7860
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=7861
